generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model USUARIOS {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  username   String   @unique
  senha_hash String
  perfil     String   @default("COMUM") // COMUM | TECNICO | ADMIN
  status     String   @default("ATIVO") // ATIVO | INATIVO
  criado_em  DateTime @default(now())

  chamados_abertos    CHAMADOS[]           @relation("solicitante")
  chamados_atribuidos CHAMADOS[]           @relation("tecnico")
  historicos          HISTORICO_CHAMADOS[]
  documentacoes       DOCUMENTACOES[]
}

model ATIVOS {
  id             Int       @id @default(autoincrement())
  nome           String
  tipo           String
  localizacao    String
  data_aquisicao DateTime?
  status         String    @default("ATIVO") // ATIVO | EM_MANUTENCAO | INATIVO
  criado_em      DateTime  @default(now())

  chamados      CHAMADOS[]
  documentacoes DOCUMENTACOES[]
}

model CHAMADOS {
  id            Int      @id @default(autoincrement())
  titulo        String
  descricao     String
  prioridade    String   @default("MEDIA")    // BAIXA | MEDIA | ALTA | CRITICA
  categoria     String   @default("OUTRO")    // HARDWARE | SOFTWARE | REDE | ACESSO | IMPRESSORA | AUDIOVISUAL | OUTRO
  status        String   @default("ABERTO")   // ABERTO | EM_ANDAMENTO | CONCLUIDO | CANCELADO
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  id_solicitante Int
  solicitante    USUARIOS @relation("solicitante", fields: [id_solicitante], references: [id])

  id_ativo Int?
  ativo    ATIVOS? @relation(fields: [id_ativo], references: [id])

  id_tecnico Int?
  tecnico    USUARIOS? @relation("tecnico", fields: [id_tecnico], references: [id])

  historico     HISTORICO_CHAMADOS[]
  documentacoes DOCUMENTACOES[]
}

model HISTORICO_CHAMADOS {
  id          Int      @id @default(autoincrement())
  comentario  String
  status_novo String?
  criado_em   DateTime @default(now())

  id_chamado Int
  chamado    CHAMADOS @relation(fields: [id_chamado], references: [id])

  id_usuario Int
  usuario    USUARIOS @relation(fields: [id_usuario], references: [id])
}

model DOCUMENTACOES {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String?
  link_externo String?
  arquivo_nome String?
  arquivo_dados Bytes?
  arquivo_mime  String?
  criado_em    DateTime @default(now())

  id_responsavel Int
  responsavel    USUARIOS @relation(fields: [id_responsavel], references: [id])

  id_ativo Int?
  ativo    ATIVOS? @relation(fields: [id_ativo], references: [id])

  id_chamado Int?
  chamado    CHAMADOS? @relation(fields: [id_chamado], references: [id])
}
