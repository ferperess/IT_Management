generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model USUARIOS {
  id         BigInt      @id @default(autoincrement())
  nome       String @db.VarChar
  email      String   @unique @db.VarChar
  username   String   @unique @db.VarChar
  senha_hash String @db.VarChar
  perfil     String   @default("USER") @db.VarChar // USER | DIRECTOR | ADMIN
  status     String   @default("ATIVO") @db.VarChar // ATIVO | INATIVO
  criado_em  DateTime @default(now()) @db.Timestamptz(6)

  pausas_iniciadas PAUSAS_SLA_CHAMADOS[] @relation("pausa_inicio")
  pausas_encerradas PAUSAS_SLA_CHAMADOS[] @relation("pausa_fim")

  chamados_abertos    CHAMADOS[]           @relation("solicitante")
  chamados_registrados CHAMADOS[]          @relation("autor_abertura")
  chamados_atribuidos CHAMADOS[]           @relation("tecnico")
  historicos          HISTORICO_CHAMADOS[]
  historicos_ativos   HISTORICO_ATIVOS[]
  documentacoes       DOCUMENTACOES[]
}

model LOGIN_RATE_LIMITS {
  key      String   @id @db.Char(64)
  hits     Int      @default(0)
  reset_at DateTime @db.Timestamptz(3)

  @@index([reset_at])
}

model LOCAIS {
  id     BigInt @id @default(autoincrement())
  nome   String @unique @db.VarChar
  status String @default("ATIVO") @db.VarChar // ATIVO | INATIVO
  ativos   ATIVOS[]
  chamados CHAMADOS[]
}

model ATIVOS {
  id             BigInt       @id @default(autoincrement())
  nome           String @db.VarChar
  patrimonio     String? @unique @db.VarChar
  tipo           String @db.VarChar
  localizacao    String? @db.VarChar
  id_local       BigInt?
  local          LOCAIS? @relation(fields: [id_local], references: [id], onDelete: NoAction, onUpdate: NoAction)
  numero_serie   String? @db.VarChar
  responsavel    String? @db.VarChar
  data_aquisicao DateTime? @db.Timestamptz(6)
  status         String    @default("ATIVO") @db.VarChar // ATIVO | MANUTENCAO | INATIVO
  criado_em      DateTime  @default(now()) @db.Timestamptz(6)

  chamados      CHAMADOS[]
  documentacoes DOCUMENTACOES[]
  historico     HISTORICO_ATIVOS[]
}

model CHAMADOS {
  id            BigInt      @id @default(autoincrement())
  exige_confirmacao Boolean @default(false)
  confirmacao_pendente Boolean @default(false)
  titulo        String @db.VarChar
  descricao     String @db.Text
  prioridade    String   @default("MEDIA") @db.VarChar // BAIXA | MEDIA | ALTA | CRITICA
  categoria     String   @default("OUTRO") @db.VarChar // HARDWARE | SOFTWARE | REDE | ACESSO | IMPRESSORA | AUDIOVISUAL | OUTRO
  status        String   @default("ABERTO") @db.VarChar // ABERTO | EM_ANDAMENTO | AGUARDANDO_USUARIO | CONCLUIDO | CANCELADO
  criado_em     DateTime @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  id_solicitante BigInt
  solicitante    USUARIOS @relation("solicitante", fields: [id_solicitante], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id_aberto_por BigInt?
  aberto_por USUARIOS? @relation("autor_abertura", fields: [id_aberto_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id_local BigInt?
  local    LOCAIS? @relation(fields: [id_local], references: [id], onDelete: NoAction, onUpdate: NoAction)

  id_ativo BigInt?
  ativo    ATIVOS? @relation(fields: [id_ativo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  id_tecnico BigInt?
  tecnico    USUARIOS? @relation("tecnico", fields: [id_tecnico], references: [id], onDelete: NoAction, onUpdate: NoAction)

  prazo_atendimento_em DateTime? @db.Timestamptz(6)
  atendimento_iniciado_em DateTime? @db.Timestamptz(6)
  prazo_resolucao_em DateTime? @db.Timestamptz(6)
  concluido_em DateTime? @db.Timestamptz(6)
  cancelado_em DateTime? @db.Timestamptz(6)
  pausas_sla PAUSAS_SLA_CHAMADOS[]
  documentos_vinculados CHAMADOS_DOCUMENTACOES[]

  historico     HISTORICO_CHAMADOS[]
  documentacoes DOCUMENTACOES[]
}

model HISTORICO_CHAMADOS {
  id          BigInt      @id @default(autoincrement())
  comentario  String @db.Text
  status_novo String? @db.VarChar
  criado_em   DateTime @default(now()) @db.Timestamptz(6)

  id_chamado BigInt
  chamado    CHAMADOS @relation(fields: [id_chamado], references: [id], onDelete: NoAction, onUpdate: NoAction)

  id_usuario BigInt
  usuario    USUARIOS @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HISTORICO_ATIVOS {
  id         BigInt   @id @default(autoincrement())
  comentario String   @db.Text
  criado_em  DateTime @default(now()) @db.Timestamptz(6)

  id_ativo   BigInt
  ativo      ATIVOS   @relation(fields: [id_ativo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id_usuario BigInt
  usuario    USUARIOS @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_ativo, criado_em], map: "HISTORICO_ATIVOS_ativo_criado_idx")
}

model DOCUMENTACOES {
  chamados_vinculados CHAMADOS_DOCUMENTACOES[]
  id           BigInt      @id @default(autoincrement())
  titulo       String @db.VarChar
  descricao    String? @db.Text
  link_externo String? @db.VarChar
  arquivo_nome String? @db.VarChar
  arquivo_dados Bytes?
  arquivo_mime  String? @db.Text
  criado_em    DateTime @default(now()) @db.Timestamptz(6)

  id_responsavel BigInt?
  responsavel    USUARIOS? @relation(fields: [id_responsavel], references: [id], onDelete: NoAction, onUpdate: NoAction)

  id_ativo BigInt?
  ativo    ATIVOS? @relation(fields: [id_ativo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  id_chamado BigInt?
  chamado    CHAMADOS? @relation(fields: [id_chamado], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PAUSAS_SLA_CHAMADOS {
  id BigInt @id @default(autoincrement())
  id_chamado BigInt
  id_usuario_inicio BigInt
  id_usuario_fim BigInt?
  iniciado_em DateTime @default(now()) @db.Timestamptz(6)
  encerrado_em DateTime? @db.Timestamptz(6)
  motivo String @db.Text
  chamado CHAMADOS @relation(fields: [id_chamado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "PAUSAS_SLA_CHAMADOS_chamado_fkey")
  usuario_inicio USUARIOS @relation("pausa_inicio", fields: [id_usuario_inicio], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "PAUSAS_SLA_CHAMADOS_usuario_inicio_fkey")
  usuario_fim USUARIOS? @relation("pausa_fim", fields: [id_usuario_fim], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "PAUSAS_SLA_CHAMADOS_usuario_fim_fkey")
  @@index([id_chamado, iniciado_em], map: "PAUSAS_SLA_CHAMADOS_chamado_inicio_idx")
  // O índice parcial de pausa aberta e os CHECKs são mantidos pelo SQL.
}

model CHAMADOS_DOCUMENTACOES {
  id_chamado BigInt
  id_documentacao BigInt
  criado_em DateTime @default(now()) @db.Timestamptz(6)
  chamado CHAMADOS @relation(fields: [id_chamado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "CHAMADOS_DOCUMENTACOES_chamado_fkey")
  documentacao DOCUMENTACOES @relation(fields: [id_documentacao], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "CHAMADOS_DOCUMENTACOES_documentacao_fkey")
  @@id([id_chamado, id_documentacao], map: "CHAMADOS_DOCUMENTACOES_pkey")
  @@index([id_documentacao], map: "CHAMADOS_DOCUMENTACOES_documentacao_idx")
}
